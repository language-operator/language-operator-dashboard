FROM node:20-alpine

RUN apk add --no-cache libc6-compat openssl

WORKDIR /app

# Install dependencies
COPY package.json package-lock.json* ./
RUN npm ci

# Move node_modules to /opt so the hostPath mount of /app doesn't shadow them.
# The init container copies /opt/node_modules into the emptyDir at /app/node_modules.
RUN mv /app/node_modules /opt/node_modules

ENV NODE_PATH=/opt/node_modules
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000

CMD ["node", "/opt/node_modules/.bin/next", "dev"]
